#!/bin/sh
# Launcher: runs cli/harness.js on the Bun runtime embedded in the installed OpenCode.
set -eu
case "$(uname -s)" in
  Darwin) BASE_DEFAULT="$HOME/Library/Application Support/team-harness" ;;
  *) BASE_DEFAULT="${XDG_DATA_HOME:-$HOME/.local/share}/team-harness" ;;
esac
BASE=${TEAM_HARNESS_HOME:-$BASE_DEFAULT}
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ ! -f "$ROOT/cli/harness.js" ]; then
  REAL=$(readlink -f -- "$0" 2>/dev/null || true)
  if [ -n "$REAL" ] && [ -f "$(dirname -- "$REAL")/../cli/harness.js" ]; then
    ROOT=$(CDPATH= cd -- "$(dirname -- "$REAL")/.." && pwd)
  else
    ROOT="$BASE/repo"
  fi
fi
RT=$(cat "$BASE/engine/current" 2>/dev/null || true)
if [ -z "$RT" ] || [ ! -x "$RT" ]; then
  echo "team-harness: not installed. Run the installer:" >&2
  echo "  curl -fsSL https://raw.githubusercontent.com/loviglass/team-harness/main/install.sh | sh" >&2
  exit 1
fi
BUN_BE_BUN=1 exec "$RT" "$ROOT/cli/harness.js" "$@"

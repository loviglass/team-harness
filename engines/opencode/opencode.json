{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "./plugins/accounts.js",
    "./plugins/output-cap.js",
    "./plugins/swap.js",
    "./plugins/gate.js"
  ],
  "model": "openai/gpt-6-astra",
  "small_model": "deepseek/deepseek-flash",
  "default_agent": "lead",
  "autoupdate": false,
  "share": "disabled",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 100608,
    "preserve_recent_tokens": 15000
  },
  "agent": {
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    },
    "general": {
      "disable": true
    },
    "explore": {
      "disable": true
    },
    "title": {
      "model": "deepseek/deepseek-flash",
      "variant": "low"
    },
    "summary": {
      "model": "deepseek/deepseek-flash",
      "variant": "low"
    },
    "compaction": {
      "model": "deepseek/deepseek-flash",
      "variant": "high"
    },
    "lead": {
      "description": "Lead on Astra (mode A: reviewer/advisor on Astra, takeover on Kimi). Tab switches to lead-kimi (swap).",
      "mode": "primary",
      "model": "openai/gpt-6-astra",
      "variant": "high",
      "prompt": "{file:./prompts/lead.md}",
      "permission": {
        "edit": "deny",
        "question": "allow",
        "webfetch": "deny",
        "websearch": "deny",
        "bash": {
          "*": "deny",
          "git status*": "allow",
          "git diff*": "allow",
          "git show*": "allow",
          "git log*": "allow",
          "git blame*": "allow"
        },
        "task": {
          "*": "deny",
          "worker": "allow",
          "scout": "allow",
          "takeover": "allow",
          "reviewer": "allow",
          "advisor": "allow",
          "analyst": "allow",
          "reviewer-kimi": "allow",
          "advisor-kimi": "allow",
          "takeover-astra": "allow",
          "analyst-ds": "allow"
        }
      }
    },
    "lead-kimi": {
      "description": "Lead on Kimi (mode B, swapped: reviewer/advisor on Kimi, takeover on Astra). Tab switches back.",
      "mode": "primary",
      "model": "kimi-code-plan-global/k3.1-pro",
      "variant": "high",
      "prompt": "{file:./prompts/lead.md}",
      "permission": {
        "edit": "deny",
        "question": "allow",
        "webfetch": "deny",
        "websearch": "deny",
        "bash": {
          "*": "deny",
          "git status*": "allow",
          "git diff*": "allow",
          "git show*": "allow",
          "git log*": "allow",
          "git blame*": "allow"
        },
        "task": {
          "*": "deny",
          "worker": "allow",
          "scout": "allow",
          "takeover": "allow",
          "reviewer": "allow",
          "advisor": "allow",
          "analyst": "allow",
          "reviewer-kimi": "allow",
          "advisor-kimi": "allow",
          "takeover-astra": "allow",
          "analyst-ds": "allow"
        }
      }
    },
    "worker": {
      "description": "Cheap implementer (DeepSeek, pay per token) for ONE small, well-specified change: a localized fix, mechanical edit, conventional test, docs. Brief should fit in ~25 steps (1-3 files). Runs the acceptance commands itself.",
      "mode": "subagent",
      "model": "deepseek/deepseek-flash",
      "variant": "high",
      "steps": 40,
      "prompt": "{file:./prompts/worker.md}",
      "permission": {
        "task": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "bash": {
          "*": "allow",
          "git push*": "ask",
          "git reset --hard*": "ask",
          "git clean -*f*": "ask",
          "git branch -D*": "ask",
          "git stash drop*": "ask",
          "git stash clear*": "ask",
          "git checkout -- *": "ask",
          "git restore *": "ask",
          "rm -rf *": "ask",
          "rm -fr *": "ask",
          "chmod -R *": "ask",
          "chown *": "ask",
          "ssh *": "ask",
          "scp *": "ask",
          "rsync *:*": "ask",
          "sftp *": "ask",
          "kubectl *": "ask",
          "helm *": "ask",
          "ansible-playbook *": "ask",
          "docker volume rm*": "ask",
          "docker compose down -v*": "ask",
          "docker-compose down -v*": "ask",
          "docker rm -f*": "ask",
          "psql *": "ask",
          "mysql *": "ask",
          "mongosh *": "ask",
          "redis-cli *": "ask",
          "gh release *": "ask",
          "gh pr merge*": "ask",
          "git push --force*": "deny",
          "git push -f*": "deny",
          "git push * --force*": "deny",
          "git push * -f*": "deny",
          "git push --mirror*": "deny",
          "git filter-branch*": "deny",
          "git filter-repo*": "deny",
          "sudo *": "deny",
          "su *": "deny",
          "rm -rf /*": "deny",
          "rm -rf ~*": "deny",
          "rm -rf $HOME*": "deny",
          "rm -rf ..*": "deny",
          "mkfs*": "deny",
          "dd *": "deny",
          "shutdown*": "deny",
          "reboot*": "deny",
          "terraform apply*": "deny",
          "terraform destroy*": "deny",
          "docker system prune*": "deny",
          "docker volume prune*": "deny",
          "npm publish*": "deny",
          "pnpm publish*": "deny",
          "yarn publish*": "deny",
          "cargo publish*": "deny",
          "curl * | sh*": "deny",
          "curl * | bash*": "deny",
          "wget * | sh*": "deny",
          "wget * | bash*": "deny"
        }
      }
    },
    "takeover": {
      "description": "Kimi implementer (subscription): multi-file features, tightly coupled or tricky changes, work that would take a worker more than ~25 steps, and any task the worker failed twice (send the brief, diff summary and failing output).",
      "mode": "subagent",
      "model": "kimi-code-plan-global/k3.1-pro",
      "variant": "high",
      "steps": 80,
      "prompt": "{file:./prompts/worker.md}",
      "permission": {
        "task": "deny",
        "bash": {
          "*": "allow",
          "git push*": "ask",
          "git reset --hard*": "ask",
          "git clean -*f*": "ask",
          "git branch -D*": "ask",
          "git stash drop*": "ask",
          "git stash clear*": "ask",
          "git checkout -- *": "ask",
          "git restore *": "ask",
          "rm -rf *": "ask",
          "rm -fr *": "ask",
          "chmod -R *": "ask",
          "chown *": "ask",
          "ssh *": "ask",
          "scp *": "ask",
          "rsync *:*": "ask",
          "sftp *": "ask",
          "kubectl *": "ask",
          "helm *": "ask",
          "ansible-playbook *": "ask",
          "docker volume rm*": "ask",
          "docker compose down -v*": "ask",
          "docker-compose down -v*": "ask",
          "docker rm -f*": "ask",
          "psql *": "ask",
          "mysql *": "ask",
          "mongosh *": "ask",
          "redis-cli *": "ask",
          "gh release *": "ask",
          "gh pr merge*": "ask",
          "git push --force*": "deny",
          "git push -f*": "deny",
          "git push * --force*": "deny",
          "git push * -f*": "deny",
          "git push --mirror*": "deny",
          "git filter-branch*": "deny",
          "git filter-repo*": "deny",
          "sudo *": "deny",
          "su *": "deny",
          "rm -rf /*": "deny",
          "rm -rf ~*": "deny",
          "rm -rf $HOME*": "deny",
          "rm -rf ..*": "deny",
          "mkfs*": "deny",
          "dd *": "deny",
          "shutdown*": "deny",
          "reboot*": "deny",
          "terraform apply*": "deny",
          "terraform destroy*": "deny",
          "docker system prune*": "deny",
          "docker volume prune*": "deny",
          "npm publish*": "deny",
          "pnpm publish*": "deny",
          "yarn publish*": "deny",
          "cargo publish*": "deny",
          "curl * | sh*": "deny",
          "curl * | bash*": "deny",
          "wget * | sh*": "deny",
          "wget * | bash*": "deny"
        }
      }
    },
    "scout": {
      "description": "Fast read-only search: WHERE is something and how is it wired. Returns paths, line ranges and short excerpts. Not for deep analysis (use analyst). Cheap.",
      "mode": "subagent",
      "model": "deepseek/deepseek-flash",
      "variant": "low",
      "steps": 30,
      "prompt": "{file:./prompts/scout.md}",
      "permission": {
        "edit": "deny",
        "task": "deny",
        "bash": {
          "*": "deny",
          "git log*": "allow",
          "git show*": "allow",
          "git diff*": "allow",
          "ls*": "allow",
          "wc *": "allow"
        },
        "gate": "deny"
      }
    },
    "analyst": {
      "description": "Read-only deep analysis on Kimi (subscription): investigate a hypothesis, audit a subsystem for real defects, explain complex behaviour, compare designs against the code. Returns verified findings with path:line. Use instead of scout when the question needs reasoning, not just search.",
      "mode": "subagent",
      "model": "kimi-code-plan-global/k3-256k",
      "variant": "high",
      "steps": 40,
      "prompt": "{file:./prompts/analyst.md}",
      "permission": {
        "edit": "deny",
        "task": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "bash": {
          "*": "deny",
          "git log*": "allow",
          "git show*": "allow",
          "git diff*": "allow",
          "ls*": "allow",
          "wc *": "allow"
        },
        "gate": "deny"
      }
    },
    "analyst-ds": {
      "description": "Swap mirror of analyst (DeepSeek). Selected automatically in Kimi-lead mode; do not call directly.",
      "mode": "subagent",
      "model": "deepseek/deepseek-flash",
      "variant": "high",
      "steps": 40,
      "prompt": "{file:./prompts/analyst.md}",
      "permission": {
        "edit": "deny",
        "task": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "bash": {
          "*": "deny",
          "git log*": "allow",
          "git show*": "allow",
          "git diff*": "allow",
          "ls*": "allow",
          "wc *": "allow"
        },
        "gate": "deny"
      }
    },
    "reviewer": {
      "description": "Independent review by a stronger model: (1) a finished risky diff against its brief, or (2) verification of specific findings at given path:line. Read-only. Expensive (ChatGPT quota): send precise claims and ranges, not open questions.",
      "mode": "subagent",
      "model": "openai/gpt-6-astra",
      "variant": "high",
      "steps": 15,
      "prompt": "{file:./prompts/reviewer.md}",
      "permission": {
        "edit": "deny",
        "task": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "bash": {
          "*": "deny",
          "git diff*": "allow",
          "git show*": "allow",
          "git log*": "allow"
        },
        "gate": "deny"
      }
    },
    "advisor": {
      "description": "Thinking only, no tools. Send it a concrete decision or a stuck failure (brief + relevant excerpts + exact error) and get a diagnosis/plan back. Cheap in tokens because it reads only what you send.",
      "mode": "subagent",
      "model": "openai/gpt-6-astra",
      "variant": "high",
      "steps": 1,
      "prompt": "{file:./prompts/advisor.md}",
      "permission": {
        "*": "deny"
      }
    },
    "reviewer-kimi": {
      "description": "Swap mirror of reviewer (Kimi). Selected automatically in Kimi-lead mode; do not call directly.",
      "mode": "subagent",
      "model": "kimi-code-plan-global/k3.1-pro",
      "variant": "high",
      "steps": 15,
      "prompt": "{file:./prompts/reviewer.md}",
      "permission": {
        "edit": "deny",
        "task": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "bash": {
          "*": "deny",
          "git diff*": "allow",
          "git show*": "allow",
          "git log*": "allow"
        },
        "gate": "deny"
      }
    },
    "advisor-kimi": {
      "description": "Swap mirror of advisor (Kimi). Selected automatically in Kimi-lead mode; do not call directly.",
      "mode": "subagent",
      "model": "kimi-code-plan-global/k3.1-pro",
      "variant": "high",
      "steps": 1,
      "prompt": "{file:./prompts/advisor.md}",
      "permission": {
        "*": "deny"
      }
    },
    "takeover-astra": {
      "description": "Swap mirror of takeover (Astra). Selected automatically in Kimi-lead mode; do not call directly.",
      "mode": "subagent",
      "model": "openai/gpt-6-astra",
      "variant": "high",
      "steps": 80,
      "prompt": "{file:./prompts/worker.md}",
      "permission": {
        "task": "deny",
        "bash": {
          "*": "allow",
          "git push*": "ask",
          "git reset --hard*": "ask",
          "git clean -*f*": "ask",
          "git branch -D*": "ask",
          "git stash drop*": "ask",
          "git stash clear*": "ask",
          "git checkout -- *": "ask",
          "git restore *": "ask",
          "rm -rf *": "ask",
          "rm -fr *": "ask",
          "chmod -R *": "ask",
          "chown *": "ask",
          "ssh *": "ask",
          "scp *": "ask",
          "rsync *:*": "ask",
          "sftp *": "ask",
          "kubectl *": "ask",
          "helm *": "ask",
          "ansible-playbook *": "ask",
          "docker volume rm*": "ask",
          "docker compose down -v*": "ask",
          "docker-compose down -v*": "ask",
          "docker rm -f*": "ask",
          "psql *": "ask",
          "mysql *": "ask",
          "mongosh *": "ask",
          "redis-cli *": "ask",
          "gh release *": "ask",
          "gh pr merge*": "ask",
          "git push --force*": "deny",
          "git push -f*": "deny",
          "git push * --force*": "deny",
          "git push * -f*": "deny",
          "git push --mirror*": "deny",
          "git filter-branch*": "deny",
          "git filter-repo*": "deny",
          "sudo *": "deny",
          "su *": "deny",
          "rm -rf /*": "deny",
          "rm -rf ~*": "deny",
          "rm -rf $HOME*": "deny",
          "rm -rf ..*": "deny",
          "mkfs*": "deny",
          "dd *": "deny",
          "shutdown*": "deny",
          "reboot*": "deny",
          "terraform apply*": "deny",
          "terraform destroy*": "deny",
          "docker system prune*": "deny",
          "docker volume prune*": "deny",
          "npm publish*": "deny",
          "pnpm publish*": "deny",
          "yarn publish*": "deny",
          "cargo publish*": "deny",
          "curl * | sh*": "deny",
          "curl * | bash*": "deny",
          "wget * | sh*": "deny",
          "wget * | bash*": "deny"
        }
      }
    }
  },
  "provider": {
    "kimi-code-plan-global": {
      "models": {
        "k3.1-pro": {
          "limit": {
            "context": 262144,
            "input": 196608,
            "output": 65536
          }
        },
        "k3-256k": {
          "limit": {
            "context": 262144,
            "output": 32768
          }
        }
      },
      "whitelist": [
        "k3.1-pro",
        "k3-256k"
      ]
    },
    "openai": {
      "whitelist": [
        "gpt-6-astra"
      ]
    },
    "deepseek": {
      "whitelist": [
        "deepseek-flash"
      ]
    }
  },
  "enabled_providers": [
    "kimi-code-plan-global",
    "openai",
    "deepseek"
  ]
}
